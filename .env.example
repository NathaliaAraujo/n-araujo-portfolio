# Copie este arquivo para .env e preencha os valores.
# Usado apenas pela serverless function em /api/contact.ts.

# Chave de API do provedor de e-mail transacional (ex: Resend).
RESEND_API_KEY=

# Endereço que recebe as mensagens do formulário de contato/orçamento.
CONTACT_TO_EMAIL=

# Endereço remetente verificado no provedor de e-mail.
CONTACT_FROM_EMAIL=

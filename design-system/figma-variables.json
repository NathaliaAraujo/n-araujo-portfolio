{
  "$schema": "portfolio-nathalia design tokens — Figma Variables import reference",
  "collections": [
    {
      "name": "Color",
      "description": "Primitive color ramps. One mode per family is NOT needed here — these are theme-agnostic base values referenced by the Semantic collection.",
      "modes": ["Value"],
      "variables": {
        "Primary/50":  "#f5fcfb", "Primary/100": "#e6f8f6", "Primary/200": "#c4eeeb",
        "Primary/300": "#9fe4dd", "Primary/400": "#69d5ca", "Primary/500": "#2ec4b6",
        "Primary/600": "#28ada0", "Primary/700": "#229388", "Primary/800": "#1c796f",
        "Primary/900": "#155f57", "Primary/950": "#104841",

        "Secondary/50":  "#f3f5f5", "Secondary/100": "#e2e8e7", "Secondary/200": "#bbc9c6",
        "Secondary/300": "#8fa6a1", "Secondary/400": "#4f736c", "Secondary/500": "#0b3d33",
        "Secondary/600": "#0a362d", "Secondary/700": "#082e27", "Secondary/800": "#072620",
        "Secondary/900": "#051f1a", "Secondary/950": "#041814",

        "Accent/50":  "#fffcf6", "Accent/100": "#fff7e9", "Accent/200": "#feedcc",
        "Accent/300": "#fee2ab", "Accent/400": "#fdd17c", "Accent/500": "#fcbf49",
        "Accent/600": "#eaaf40", "Accent/700": "#d59c36", "Accent/800": "#c08a2c",
        "Accent/900": "#ab7722", "Accent/950": "#996719",

        "Sky/50":  "#fafeff", "Sky/100": "#f3fcff", "Sky/200": "#e3f8ff",
        "Sky/300": "#d1f4ff", "Sky/400": "#b7eeff", "Sky/500": "#9be7ff",
        "Sky/600": "#87d1ea", "Sky/700": "#71b8d1", "Sky/800": "#5b9fb9",
        "Sky/900": "#4486a0", "Sky/950": "#31708b",

        "Neutral/50":  "#fff7e6", "Neutral/100": "#f6f0e0", "Neutral/200": "#e3e2d1",
        "Neutral/300": "#cdd1c1", "Neutral/400": "#adb9aa", "Neutral/500": "#859a8c",
        "Neutral/600": "#74897d", "Neutral/700": "#60766b", "Neutral/800": "#4d6259",
        "Neutral/900": "#394f47", "Neutral/950": "#283e37"
      }
    },
    {
      "name": "Semantic/Surface",
      "description": "Alias variables. Each points at a Color-collection variable per mode — bind these to fills, not raw hex, so components repaint automatically on mode switch.",
      "modes": ["Light", "Dark"],
      "variables": {
        "surface/base":            { "Light": "Color/Neutral/50",  "Dark": "Color/Neutral/950" },
        "surface/raised":          { "Light": "Color/Neutral/100", "Dark": "Color/Neutral/900" },
        "surface/sunken":          { "Light": "Color/Neutral/200", "Dark": "Color/Neutral/800" },
        "surface/inverse":         { "Light": "Color/Neutral/950", "Dark": "Color/Neutral/50" },
        "surface/brand":           { "Light": "Color/Primary/500", "Dark": "Color/Primary/400" },
        "surface/brand-hover":     { "Light": "Color/Primary/600", "Dark": "Color/Primary/300" },
        "surface/brand-active":    { "Light": "Color/Primary/700", "Dark": "Color/Primary/500" },
        "surface/brand-secondary": { "Light": "Color/Secondary/500", "Dark": "Color/Secondary/300" },
        "surface/accent":          { "Light": "Color/Accent/500", "Dark": "Color/Accent/400" },
        "surface/accent-hover":    { "Light": "Color/Accent/600", "Dark": "Color/Accent/300" }
      }
    },
    {
      "name": "Semantic/Text",
      "modes": ["Light", "Dark"],
      "variables": {
        "text/primary":      { "Light": "Color/Neutral/900", "Dark": "Color/Neutral/50",  "contrast": "8.27:1 / 10.74:1" },
        "text/secondary":    { "Light": "Color/Neutral/700", "Dark": "Color/Neutral/300", "contrast": "4.58:1 / 7.35:1" },
        "text/muted":        { "Light": "Color/Neutral/600", "Dark": "Color/Neutral/500", "contrast": "3.51:1 / 3.81:1 — large text or UI labels only, not AA body copy" },
        "text/inverse":      { "Light": "Color/Neutral/50",  "Dark": "Color/Neutral/950" },
        "text/on-primary":   { "Light": "Color/Neutral/950", "Dark": "Color/Neutral/950", "contrast": "5.28:1 / 6.53:1" },
        "text/on-secondary": { "Light": "Color/Neutral/50",  "Dark": "Color/Neutral/950", "contrast": "11.39:1 / 4.44:1" },
        "text/on-accent":    { "Light": "Color/Neutral/900", "Dark": "Color/Neutral/950", "contrast": "5.32:1 / 7.95:1" },
        "text/link":         { "Light": "Color/Sky/950",     "Dark": "Color/Sky/300",     "contrast": "5.16:1 / 9.86:1" },
        "text/link-hover":   { "Light": "Color/Secondary/500", "Dark": "Color/Sky/100" }
      }
    },
    {
      "name": "Semantic/Border",
      "modes": ["Light", "Dark"],
      "variables": {
        "border/subtle":      { "Light": "Color/Neutral/200", "Dark": "Color/Neutral/800" },
        "border/default":     { "Light": "Color/Neutral/300", "Dark": "Color/Neutral/700" },
        "border/interactive": { "Light": "Color/Neutral/600", "Dark": "Color/Neutral/500", "contrast": "3.51:1 / 3.81:1 (non-text UI, meets 3:1)" },
        "focus/ring":         { "Light": "Color/Accent/950",  "Dark": "Color/Accent/300",  "contrast": "4.57:1 / 9.09:1 (meets 3:1)" }
      }
    }
  ],
  "import_notes": [
    "Create the 'Color' collection first with a single 'Value' mode and paste in every Primary/Secondary/Accent/Sky/Neutral swatch as its own variable.",
    "Create the three 'Semantic/*' collections next, each with Light and Dark modes. For every variable, set its value to an ALIAS pointing at the matching Color-collection variable (not a raw hex) — this is what makes mode-switching work.",
    "In Figma: right-click a variable's value field → 'Create alias' → pick the Color-collection variable named in this file.",
    "Apply Semantic/* variables to fills, strokes, and text color — never apply Color/* primitives directly to a layer if a Semantic equivalent exists, so future re-theming only touches the alias target.",
    "A plugin such as 'Variables Import/Export' or 'Variables2CSS' can bulk-import this JSON's Color collection; the Semantic alias wiring is quickest done by hand once, since alias creation isn't universally scriptable across import plugins."
  ]
}
